include README.md pyproject.toml
recursive-include benchmarks/models *.prism
recursive-include benchmarks/specs *.json
recursive-include experiments *.json *.md
recursive-include scripts *.py
recursive-include docs *.md
recursive-include tests *.py *.json *.pm
global-exclude *.py[cod] .DS_Store
prune results
prune output
prune tmp
prune build
